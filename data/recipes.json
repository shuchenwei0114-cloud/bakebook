[
  {
    "id": "basque-cheesecake",
    "name": "吐司原味",
    "category": "面包",
    "overnightPrep": false,
    "ingredients": [
      "高筋面粉285g",
      "淡奶油60g",
      "冰牛奶110g",
      "细砂糖30g",
      "全蛋液40g",
      "酵母3g",
      "盐3g",
      "黄油20g"
    ],
    "steps": [
      {
        "text": "冷冻模具",
        "minutes": 15
      },
      {
        "text": "把所有材料放进模具搅打，除了黄油和盐之外，不要让面团的温度超过23",
        "minutes": 10
      },
      {
        "text": "打出粗膜之后，放黄油和盐继续搅打到出手套膜",
        "minutes": 10
      },
      {
        "text": "发酵1小时",
        "minutes": 60
      },
      {
        "text": "一发之后拿出来切成三块，揉成圆形之后松弛10分钟",
        "minutes": 15
      },
      {
        "text": "松弛之后擀成长条放入模具，然后等二发",
        "minutes": 60
      },
      {
        "text": "八分满之后开始烤\n320度 40分钟到1小时",
        "minutes": 50
      }
    ],
    "notes": "🔥真的太香了，北海道吐司🔥敲柔软的生吐司 所需食材... https://xhslink.cn/o/5CJlAsTkwWA \n跳转【小红书】看看这篇分享！"
  },
  {
    "id": "jasmine-cream-cake",
    "name": "茉莉淡奶油蛋糕",
    "category": "蛋糕",
    "overnightPrep": true,
    "ingredients": [
      "鸡蛋 3个",
      "淡奶油 140克",
      "茉莉花茶 4克",
      "低筋面粉 55克",
      "细砂糖 40克",
      "柠檬汁 数滴"
    ],
    "steps": [
      {
        "text": "140克淡奶油加入4克茉莉花茶，盖上保鲜膜浸泡一夜。",
        "minutes": 0
      },
      {
        "text": "过滤出120克茉莉奶油，加入蛋黄，隔水加热并搅拌均匀；筛入低筋面粉，搅拌至顺滑。",
        "minutes": 10
      },
      {
        "text": "蛋清加入柠檬汁，细砂糖分3次加入，打发至小弯钩状。",
        "minutes": 10
      },
      {
        "text": "取1/3蛋白霜加入蛋黄糊中翻拌均匀，再倒回剩余蛋白霜中翻拌均匀；将面糊倒入提前铺好油纸的模具中。",
        "minutes": 5
      },
      {
        "text": "烤盘中放温水，采用水浴法，送入预热好的烤箱中下层，上下火284°F烘烤。",
        "minutes": 30
      },
      {
        "text": "转为上火311°F、下火302°F继续烘烤。",
        "minutes": 30
      },
      {
        "text": "烤好的蛋糕取出轻震两下震出热气，无需倒扣，脱模晾凉即可。",
        "minutes": 0
      }
    ],
    "notes": "水浴法做出来会更柔润绵密。茉莉淡奶油浸泡后过滤，使用120克。蛋黄糊隔水加热。"
  }
]
